generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id        String   @id
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  userId    String?
  User      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
}

model DispenseTransaction {
  id               String             @id
  transactionNo    String             @unique
  date             DateTime           @default(now())
  patientType      PatientType
  patientName      String
  phone            String?
  clinicianName    String
  prescriptionDate DateTime?
  diagnosis        String?
  subtotal         Decimal            @db.Decimal(12, 2)
  discount         Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal            @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  cashTendered     Decimal?           @db.Decimal(12, 2)
  changeAmount     Decimal?           @db.Decimal(12, 2)
  mpesaCode        String?
  status           TransactionStatus  @default(COMPLETED)
  createdAt        DateTime           @default(now())
  patientId        String?
  userId           String?
  Patient          Patient?           @relation(fields: [patientId], references: [id])
  User             User?              @relation(fields: [userId], references: [id])
  PrescriptionItem PrescriptionItem[]

  @@index([date])
  @@index([patientId])
}

model Drug {
  id               String             @id
  code             String             @unique
  name             String
  genericName      String
  category         String
  formulation      String
  batchNo          String
  manufactureDate  DateTime?
  expiryDate       DateTime
  qty              Int                @default(0)
  unit             String
  buyingPrice      Decimal            @db.Decimal(12, 2)
  sellingPrice     Decimal            @db.Decimal(12, 2)
  markupPercent    Decimal            @db.Decimal(8, 2)
  status           DrugStatus         @default(IN_STOCK)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  PrescriptionItem PrescriptionItem[]
}

model Patient {
  id                  String                @id
  name                String
  phone               String
  email               String?
  age                 Int?
  gender              PatientGender?
  address             String?
  allergies           String?
  totalVisits         Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  DispenseTransaction DispenseTransaction[]

  @@index([name])
  @@index([phone])
}

model PharmacySettings {
  id                String   @id
  pharmacyName      String
  tagline           String?
  address           String?
  phone             String?
  email             String?
  currency          String   @default("KES")
  clinicianName     String?
  expiryAlertDays   Int      @default(90)
  reorderAlertLevel Int      @default(10)
  logoUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PrescriptionItem {
  id                  String              @id
  drugId              String
  drugCode            String
  drugName            String
  batchNo             String
  expiryDate          DateTime
  availableQty        Int
  qty                 Int
  unitPrice           Decimal             @db.Decimal(12, 2)
  frequency           HealthcareFrequency
  route               HealthcareRoute
  duration            Int
  durationUnit        String
  specialInstructions String?
  lineTotal           Decimal             @db.Decimal(12, 2)
  transactionId       String
  Drug                Drug                @relation(fields: [drugId], references: [id])
  DispenseTransaction DispenseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([drugId])
  @@index([transactionId])
}

model StockAdjustment {
  id          String         @id @default(cuid())
  date        DateTime       @default(now())
  drugId      String
  drugName    String
  batchNo     String
  previousQty Int
  adjustedQty Int
  type        AdjustmentType
  reason      String
  adjustedBy  String
  createdAt   DateTime       @default(now())
  userId      String?
  User        User?          @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([drugId])
}

model Supplier {
  id            String   @id
  name          String
  contactPerson String
  phone         String
  email         String
  address       String
  leadTimeDays  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id                  String                @id
  name                String
  email               String                @unique
  phone               String?
  role                UserRole              @default(PHARMACIST)
  passwordHash        String
  isVerified          Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  AuditLog            AuditLog[]
  DispenseTransaction DispenseTransaction[]
  EmailVerification   EmailVerification?
  RefreshToken        RefreshToken[]
  StockAdjustment     StockAdjustment[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum AdjustmentType {
  LOSS_DAMAGE
  EXPIRY_REMOVAL
  AUDIT_RECONCILIATION
  RETURN_TO_SUPPLIER
}

enum DrugStatus {
  IN_STOCK
  LOW_STOCK
  EXPIRED
  OUT_OF_STOCK
}

enum HealthcareFrequency {
  OD
  BD_BID
  TID
  QID
  STAT
  PRN
  Q4H
  Q6H
  Q8H
  Q12H
  ON
}

enum HealthcareRoute {
  ORAL
  TOPICAL
  INTRAVENOUS
  INTRAMUSCULAR
  SUBCUTANEOUS
  INHALATION
  OPHTHALMIC
  OTIC
  RECTAL
  SUBLINGUAL
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
}

enum PatientType {
  WALK_IN
  REGISTERED
}

enum PaymentMethod {
  CASH
  MPESA
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
  PENDING
}

enum UserRole {
  ADMIN
  PHARMACIST
  CLINICIAN
}


