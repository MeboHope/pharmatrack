generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  type      OrganizationType
  status    OrganizationStatus @default(ACTIVE)
  address   String?
  phone     String?
  email     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships      OrganizationMembership[]
  drugs            Drug[]
  patients         Patient[]
  suppliers        Supplier[]
  transactions     DispenseTransaction[]
  stockAdjustments StockAdjustment[]
  settings         PharmacySettings?
  auditLogs        AuditLog[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole @default(PHARMACIST)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

model AuditLog {
  id             String   @id
  action         String
  entity         String
  entityId       String?
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())
  userId         String?
  organizationId String?

  User         User?         @relation(fields: [userId], references: [id])
  Organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
  @@index([organizationId])
}

model DispenseTransaction {
  id               String            @id
  transactionNo    String            @unique
  date             DateTime          @default(now())
  patientType      PatientType
  patientName      String
  phone            String?
  clinicianName    String
  prescriptionDate DateTime?
  diagnosis        String?
  subtotal         Decimal           @db.Decimal(12, 2)
  discount         Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal           @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  cashTendered     Decimal?          @db.Decimal(12, 2)
  changeAmount     Decimal?          @db.Decimal(12, 2)
  mpesaCode        String?
  status           TransactionStatus @default(COMPLETED)
  createdAt        DateTime          @default(now())
  patientId        String?
  userId           String?
  organizationId   String

  Patient      Patient?     @relation(fields: [patientId], references: [id])
  User         User?        @relation(fields: [userId], references: [id])
  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  PrescriptionItem PrescriptionItem[]

  @@index([date])
  @@index([patientId])
  @@index([organizationId])
}

model Drug {
  id              String     @id @default(cuid())
  code            String     @unique
  name            String
  genericName     String
  category        String
  formulation     String
  batchNo         String
  manufactureDate DateTime?
  expiryDate      DateTime
  qty             Int        @default(0)
  unit            String
  buyingPrice     Decimal    @db.Decimal(12, 2)
  sellingPrice    Decimal    @db.Decimal(12, 2)
  markupPercent   Decimal    @db.Decimal(8, 2)
  status          DrugStatus @default(IN_STOCK)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organizationId String

  Organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  PrescriptionItem PrescriptionItem[]

  @@index([organizationId])
}

model Patient {
  id          String         @id @default(cuid())
  name        String
  phone       String
  email       String?
  age         Int?
  gender      PatientGender?
  address     String?
  allergies   String?
  totalVisits Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organizationId String

  Organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  DispenseTransaction DispenseTransaction[]

  @@index([name])
  @@index([phone])
  @@index([organizationId])
}

model PharmacySettings {
  id                String   @id
  pharmacyName      String
  tagline           String?
  address           String?
  phone             String?
  email             String?
  currency          String   @default("KES")
  clinicianName     String?
  expiryAlertDays   Int      @default(90)
  reorderAlertLevel Int      @default(10)
  logoUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organizationId String @unique

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model PrescriptionItem {
  id                  String              @id
  drugId              String
  drugCode            String
  drugName            String
  batchNo             String
  expiryDate          DateTime
  availableQty        Int
  qty                 Int
  unitPrice           Decimal             @db.Decimal(12, 2)
  frequency           HealthcareFrequency
  route               HealthcareRoute
  duration            Int
  durationUnit        String
  specialInstructions String?
  lineTotal           Decimal             @db.Decimal(12, 2)
  transactionId       String

  Drug                Drug                @relation(fields: [drugId], references: [id])
  DispenseTransaction DispenseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([drugId])
  @@index([transactionId])
}

model StockAdjustment {
  id             String         @id @default(cuid())
  date           DateTime       @default(now())
  drugId         String
  drugName       String
  batchNo        String
  previousQty    Int
  adjustedQty    Int
  type           AdjustmentType
  reason         String
  adjustedBy     String
  createdAt      DateTime       @default(now())
  userId         String?
  organizationId String

  User         User?        @relation(fields: [userId], references: [id])
  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([drugId])
  @@index([organizationId])
}

model Supplier {
  id            String   @id
  name          String
  contactPerson String
  phone         String
  email         String
  address       String
  leadTimeDays  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizationId String

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  role         UserRole @default(PHARMACIST)
  passwordHash String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  AuditLog            AuditLog[]
  DispenseTransaction DispenseTransaction[]
  StockAdjustment     StockAdjustment[]
  EmailVerification   EmailVerification?
  RefreshToken        RefreshToken[]

  memberships OrganizationMembership[]

  @@index([role])
}

model EmailVerification {
  id        String   @id
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RefreshToken {
  id                String    @id
  tokenHash         String    @unique
  userId            String
  organizationId    String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum OrganizationType {
  PHARMACY
  CLINIC
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum AdjustmentType {
  LOSS_DAMAGE
  EXPIRY_REMOVAL
  AUDIT_RECONCILIATION
  RETURN_TO_SUPPLIER
}

enum DrugStatus {
  IN_STOCK
  LOW_STOCK
  EXPIRED
  OUT_OF_STOCK
}

enum HealthcareFrequency {
  OD
  BD_BID
  TID
  QID
  STAT
  PRN
  Q4H
  Q6H
  Q8H
  Q12H
  ON
}

enum HealthcareRoute {
  ORAL
  TOPICAL
  INTRAVENOUS
  INTRAMUSCULAR
  SUBCUTANEOUS
  INHALATION
  OPHTHALMIC
  OTIC
  RECTAL
  SUBLINGUAL
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
}

enum PatientType {
  WALK_IN
  REGISTERED
}

enum PaymentMethod {
  CASH
  MPESA
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
  PENDING
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  CLINICIAN
}
