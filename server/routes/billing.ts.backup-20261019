/* ============================================================
   GET /api/billing/usage
   ============================================================ */

router.get("/usage", async (request, response) => {
  try {
    const organizationId = request.auth?.organizationId;

    if (!organizationId) {
      response.status(403).json({
        success: false,
        message: "Organization context is required.",
      });
      return;
    }

    const now = new Date();

    /*
     * Match the subscription-selection policy used by the
     * subscription-limit service: the latest subscription wins.
     * An older ACTIVE subscription must not override a newer
     * PENDING, CANCELED, or otherwise inactive subscription.
     */
    const subscription =
      await prisma.organizationSubscription.findFirst({
        where: { organizationId },
        orderBy: [
          { createdAt: "desc" },
          { id: "desc" },
        ],
        select: {
          id: true,
          status: true,
          endedAt: true,
          currentPeriodStart: true,
          currentPeriodEnd: true,
          trialStartsAt: true,
          trialEndsAt: true,
          plan: {
            select: {
              maxUsers: true,
              maxProducts: true,
              maxLocations: true,
              maxMonthlyTransactions: true,
            },
          },
        },
      });

    let periodStart: Date | null = null;
    let periodEnd: Date | null = null;

    if (subscription && !subscription.endedAt) {
      if (
        subscription.status === "ACTIVE" &&
        subscription.currentPeriodStart &&
        subscription.currentPeriodEnd &&
        now >= subscription.currentPeriodStart &&
        now < subscription.currentPeriodEnd
      ) {
        periodStart = subscription.currentPeriodStart;
        periodEnd = subscription.currentPeriodEnd;
      } else if (
        subscription.status === "TRIALING" &&
        subscription.trialStartsAt &&
        subscription.trialEndsAt &&
        now >= subscription.trialStartsAt &&
        now < subscription.trialEndsAt
      ) {
        periodStart = subscription.trialStartsAt;
        periodEnd = subscription.trialEndsAt;
      }
    }

    const [
      memberCount,
      pendingInvitationCount,
      productCount,
      monthlyTransactionCount,
    ] = await Promise.all([
      prisma.organizationMembership.count({
        where: { organizationId },
      }),

      prisma.organizationInvitation.count({
        where: {
          organizationId,
          acceptedAt: null,
          revokedAt: null,
          expiresAt: { gt: now },
        },
      }),

      prisma.product.count({
        where: { organizationId },
      }),

      periodStart && periodEnd
        ? prisma.dispenseTransaction.count({
            where: {
              organizationId,
              status: "COMPLETED",
              date: {
                gte: periodStart,
                lt: periodEnd,
              },
            },
          })
        : Promise.resolve(0),
    ]);

    const maxUsers = subscription?.plan.maxUsers ?? null;
    const maxProducts = subscription?.plan.maxProducts ?? null;
    const maxLocations = subscription?.plan.maxLocations ?? null;
    const maxMonthlyTransactions =
      subscription?.plan.maxMonthlyTransactions ?? null;

    response.json({
      success: true,
      data: {
        subscription: {
          id: subscription?.id ?? null,
          status: subscription?.status ?? null,
          hasValidUsagePeriod: Boolean(periodStart && periodEnd),
        },

        users: {
          used: memberCount,
          limit: maxUsers,
        },

        pendingInvitations: {
          used: pendingInvitationCount,
        },

        seats: {
          used: memberCount + pendingInvitationCount,
          limit: maxUsers,
        },

        products: {
          used: productCount,
          limit: maxProducts,
        },

        monthlyTransactions: {
          used: monthlyTransactionCount,
          limit: maxMonthlyTransactions,
          periodStart,
          periodEnd,
        },

        locations: {
          tracked: false,
          used: null,
          limit: maxLocations,
        },

        generatedAt: now,
      },
    });
  } catch (error) {
    console.error(
      "Failed to fetch organization subscription usage:",
      error,
    );

    response.status(500).json({
      success: false,
      message: "Failed to fetch organization subscription usage.",
    });
  }
});

/* ============================================================
   GET /api/billing/payments
   ============================================================ */

router.get("/payments", async (request, response) => {
  try {
    const organizationId = request.auth?.organizationId;

    if (!organizationId) {
      response.status(403).json({
        success: false,
        message: "Organization context is required.",
      });
      return;
    }

    const parsedLimit = Number(request.query.limit ?? 25);
    const limit =
      Number.isInteger(parsedLimit) && parsedLimit >= 1
        ? Math.min(parsedLimit, 100)
        : 25;

    const payments = await prisma.billingPayment.findMany({
      where: {
  OR: [
    {
      subscription: {
        is: { organizationId },
      },
    },
    {
      subscriptionChangeRequest: {
        is: { organizationId },
      },
    },
  ],
},
      orderBy: { createdAt: "desc" },
      take: limit,
      select: {
        id: true,
        provider: true,
        method: true,
        status: true,
        amount: true,
        currency: true,
        providerReference: true,
        receiptNumber: true,
        failureCode: true,
        failureMessage: true,
        initiatedAt: true,
        paidAt: true,
        failedAt: true,
        createdAt: true,
        updatedAt: true,
        subscription: {
          select: {
            id: true,
            billingInterval: true,
            plan: {
              select: {
                code: true,
                name: true,
              },
            },
          },
        },
        subscriptionChangeRequest: {
          select: {
            id: true,
            requestedInterval: true,
            requestedPlan: {
              select: {
                code: true,
                name: true,
              },
            },
          },
        },
      },
    });

    response.json({
      success: true,
      data: payments,
    });
  } catch (error) {
    console.error(
      "Failed to fetch organization billing payments:",
      error,
    );

    response.status(500).json({
      success: false,
      message: "Failed to fetch organization billing payments.",
    });
  }
});
router.get("/payments/:id/verify", async (request, response) => {
  const organizationId = request.auth?.organizationId;
  const paymentId = request.params.id;

  if (!organizationId) {
    return response.status(401).json({
      success: false,
      message: "Organization context is required.",
    });
  }

  try {
    const payment = await prisma.billingPayment.findFirst({
      where: {
        id: paymentId,
        provider: "INTASEND",
        subscriptionChangeRequest: {
          is: { organizationId },
        },
      },
      select: {
        id: true,
        status: true,
        providerReference: true,
        providerCheckoutId: true,
        subscriptionId: true,
      },
    });

    if (!payment) {
      return response.status(404).json({
        success: false,
        message: "The payment was not found for this organization.",
      });
    }

    if (payment.status === "SUCCEEDED" && payment.subscriptionId) {
      return response.json({
        success: true,
        data: {
          paymentId: payment.id,
          status: "SUCCEEDED",
          subscriptionId: payment.subscriptionId,
        },
      });
    }

    console.error("[IntaSend verification identifiers]", {
  paymentId: payment.id,
  hasProviderReference: Boolean(payment.providerReference),
  providerReferencePrefix:
    payment.providerReference?.slice(0, 8) ?? null,
  hasProviderCheckoutId: Boolean(payment.providerCheckoutId),
  providerCheckoutIdPrefix:
    payment.providerCheckoutId?.slice(0, 8) ?? null,
});

const verified = await verifyIntaSendStatus({
  invoiceId: payment.providerReference,
  checkoutId: payment.providerCheckoutId,
});

    if (verified.apiRef !== payment.id) {
      return response.status(409).json({
        success: false,
        message:
          "The provider payment reference does not match this payment record.",
      });
    }

    if (verified.state === "COMPLETE") {
      const activation = await activateVerifiedIntaSendPayment(
        payment.id,
        verified,
      );

      return response.json({
        success: true,
        data: {
          paymentId: payment.id,
          status: "SUCCEEDED",
          subscriptionId: activation.subscriptionId,
          alreadyProcessed: activation.alreadyProcessed,
        },
      });
    }

    if (
      verified.state === "FAILED" ||
      verified.state === "CANCELED"
    ) {
      const nextStatus =
        verified.state === "CANCELED" ? "CANCELED" : "FAILED";

      await prisma.billingPayment.updateMany({
        where: {
          id: payment.id,
          status: {
            in: ["PENDING", "PROCESSING"],
          },
        },
        data: {
          status: nextStatus,
          failedAt: new Date(),
          failureCode: verified.state,
          failureMessage:
            `IntaSend payment state: ${verified.state}`,
        },
      });

      return response.json({
        success: true,
        data: {
          paymentId: payment.id,
          status: nextStatus,
        },
      });
    }

    if (
      verified.state === "PROCESSING" ||
      verified.state === "RETRY" ||
      verified.state === "PARTIAL"
    ) {
      await prisma.billingPayment.updateMany({
        where: {
          id: payment.id,
          status: "PENDING",
        },
        data: {
          status: "PROCESSING",
        },
      });
    }

    return response.json({
      success: true,
      data: {
        paymentId: payment.id,
        status: verified.state,
        message:
          "Payment is not yet confirmed. Check again shortly.",
      },
    });
  } catch (error) {
    if (error instanceof BillingPaymentActivationError) {
      return response.status(409).json({
        success: false,
        message: error.message,
        code: error.code,
      });
    }

    console.error("Payment verification failed:", error);

    return response.status(502).json({
      success: false,
      message:
        "Unable to verify payment with IntaSend. Please try again shortly.",
    });
  }
});

export default router;