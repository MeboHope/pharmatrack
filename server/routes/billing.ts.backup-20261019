/* ============================================================
   POST /api/billing/plan-change-requests

   Creates a request only. It does not change the subscription
   or initiate/confirm a payment.
   ============================================================ */

router.post("/plan-change-requests", async (request, response) => {
  try {
    const organizationId = request.auth?.organizationId;
    const requestedById = request.auth?.sub;

    if (!organizationId || !requestedById) {
      response.status(403).json({
        success: false,
        message: "Authenticated organization context is required.",
      });
      return;
    }

    const body = request.body as {
      planId?: unknown;
      billingInterval?: unknown;
      requestReason?: unknown;
    };

    const planId =
      typeof body.planId === "string"
        ? body.planId.trim()
        : "";

    const billingInterval = body.billingInterval;

    const requestReason =
      typeof body.requestReason === "string"
        ? body.requestReason.trim()
        : "";

    if (!planId) {
      response.status(400).json({
        success: false,
        message: "A subscription plan is required.",
      });
      return;
    }

    if (
      billingInterval !== "MONTHLY" &&
      billingInterval !== "ANNUAL"
    ) {
      response.status(400).json({
        success: false,
        message: "Billing interval must be MONTHLY or ANNUAL.",
      });
      return;
    }

    if (requestReason.length > 1000) {
      response.status(400).json({
        success: false,
        message: "The request reason cannot exceed 1000 characters.",
      });
      return;
    }


    /*
     * Lock the organization row while checking for a pending
     * request. This serializes concurrent request submissions
     * for the same organization.
     *
     * The organization ID comes only from verified auth context.
     */
    const createdRequest = await prisma.$transaction(
      async (tx) => {
        const organizations = await tx.$queryRaw<
          Array<{ id: string }>
        >`
          SELECT "id"
          FROM "Organization"
          WHERE "id" = ${organizationId}
          FOR UPDATE
        `;

        if (organizations.length === 0) {
          throw new Error("ORGANIZATION_NOT_FOUND");
        }

        const plan = await tx.subscriptionPlan.findFirst({
          where: {
            id: planId,
            isActive: true,
          },
          select: {
            id: true,
            code: true,
            name: true,
            monthlyPrice: true,
            annualPrice: true,
            currency: true,
          },
        });

        if (!plan) {
          throw new Error("PLAN_NOT_AVAILABLE");
        }

        const pendingRequest =
          await tx.subscriptionChangeRequest.findFirst({
            where: {
              organizationId,
              status: "PENDING",
            },
            select: { id: true },
          });

        if (pendingRequest) {
          throw new Error("PENDING_REQUEST_EXISTS");
        }

        /*
         * Do not create a redundant request for the same plan
         * and billing interval if that is already the latest
         * subscription configuration.
         *
         * Pending or inactive subscriptions are not treated as
         * active entitlements here.
         */
        const currentSubscription =
          await tx.organizationSubscription.findFirst({
            where: {
              organizationId,
              status: {
                in: ["ACTIVE", "TRIALING"],
              },
              endedAt: null,
            },
            orderBy: [
              { createdAt: "desc" },
              { id: "desc" },
            ],
            select: {
              planId: true,
              billingInterval: true,
            },
          });

        if (
          currentSubscription?.planId === plan.id &&
          currentSubscription.billingInterval === billingInterval
        ) {
          throw new Error("PLAN_ALREADY_CURRENT");
        }

        return tx.subscriptionChangeRequest.create({
          data: {
            organizationId,
            requestedById,
            requestedPlanId: plan.id,
            requestedInterval: billingInterval,
            requestReason: requestReason || null,
          },
          select: planChangeRequestSelect,
        });
      },
      {
        maxWait: 5000,
        timeout: 10000,
      },
    );

    await auditService.log({
      action: "SUBSCRIPTION_CHANGE_REQUESTED",
      entity: "SubscriptionChangeRequest",
      entityId: createdRequest.id,
      details: JSON.stringify({
        requestedPlanId: createdRequest.requestedPlanId,
        requestedPlanCode: createdRequest.requestedPlan.code,
        requestedInterval: createdRequest.requestedInterval,
        status: createdRequest.status,
      }),
      userId: requestedById,
      ipAddress: request.ip,
      organizationId,
    });

    response.status(201).json({
      success: true,
      message:
        "Plan-change request submitted. Your current subscription has not been changed.",
      data: createdRequest,
    });
  } catch (error) {
    if (error instanceof Error) {
      if (error.message === "ORGANIZATION_NOT_FOUND") {
        response.status(403).json({
          success: false,
          message: "The authenticated organization could not be found.",
        });
        return;
      }

      if (error.message === "PLAN_NOT_AVAILABLE") {
        response.status(400).json({
          success: false,
          message: "The selected subscription plan is unavailable.",
        });
        return;
      }

      if (error.message === "PENDING_REQUEST_EXISTS") {
        response.status(409).json({
          success: false,
          message:
            "Your organization already has a pending plan-change request.",
        });
        return;
      }

      if (error.message === "PLAN_ALREADY_CURRENT") {
        response.status(409).json({
          success: false,
          message:
            "Your organization already has this plan and billing interval.",
        });
        return;
      }
    }

    console.error(
      "Failed to submit subscription change request:",
      error,
    );

    response.status(500).json({
      success: false,
      message: "Failed to submit the plan-change request.",
    });
  }
});
router.post(
  "/plan-change-requests/:id/checkout",
  async (request, response) => {
    const organizationId = request.auth?.organizationId;
    const userId = request.auth?.sub;
    const requestId = request.params.id;
    const method = request.body?.method;

    if (!organizationId || !userId) {
      return response.status(401).json({
        success: false,
        message: "Authentication and organization context are required.",
      });
    }

    if (method !== "MPESA" && method !== "CARD") {
      return response.status(400).json({
        success: false,
        message: "Choose MPESA or CARD as the payment method.",
      });
    }

    let paymentId: string | undefined;

    try {
      const configuredAppUrl = process.env.APP_URL?.trim();

      if (!configuredAppUrl) {
        throw new Error("APP_URL is not configured.");
      }

      let appUrl: URL;

      try {
        appUrl = new URL(configuredAppUrl);
      } catch {
        throw new Error("APP_URL must be a valid absolute URL.");
      }

      if (
        !["https:", "http:"].includes(appUrl.protocol) ||
        (process.env.NODE_ENV === "production" &&
          appUrl.protocol !== "https:") ||
        appUrl.username ||
        appUrl.password
      ) {
        throw new Error(
          "APP_URL must be a trusted HTTPS application URL in production.",
        );
      }

      /*
       * Create the payment record before calling IntaSend.
       * The organization lock prevents concurrent checkout attempts
       * from creating multiple active attempts for the same request.
       */
      const checkoutPreparation = await prisma.$transaction(
        async (tx) => {
          await tx.$queryRaw<Array<{ id: string }>>`
            SELECT "id"
            FROM "Organization"
            WHERE "id" = ${organizationId}
            FOR UPDATE
          `;

          const changeRequest =
            await tx.subscriptionChangeRequest.findFirst({
              where: {
                id: requestId,
                organizationId,
              },
              include: {
                requestedPlan: true,
              },
            });

          if (!changeRequest) {
            throw new Error(
              "The plan-change request was not found.",
            );
          }

          if (changeRequest.status !== "APPROVED") {
            throw new Error(
              "Only approved plan-change requests can proceed to checkout.",
            );
          }

          if (changeRequest.appliedAt) {
            throw new Error(
              "This plan-change request has already been applied.",
            );
          }

          if (!changeRequest.requestedPlan.isActive) {
            throw new Error(
              "The requested subscription plan is no longer active.",
            );
          }

          const plan = changeRequest.requestedPlan;

          const amount =
            changeRequest.requestedInterval === "MONTHLY"
              ? plan.monthlyPrice
              : plan.annualPrice;

          if (Number(amount.toString()) <= 0) {
            throw new Error(
              "This plan does not have a payable price for the selected interval.",
            );
          }

          const user = await tx.user.findUnique({
            where: { id: userId },
            select: {
              id: true,
              name: true,
              email: true,
              phone: true,
            },
          });

          if (!user?.email?.trim()) {
            throw new Error(
              "Add a valid email address to your account before checkout.",
            );
          }

          const existingPayment =
            await tx.billingPayment.findFirst({
              where: {
                subscriptionChangeRequestId: changeRequest.id,
                provider: "INTASEND",
                status: {
                  in: ["PENDING", "PROCESSING"],
                },
              },
              orderBy: {
                createdAt: "desc",
              },
            });

          if (existingPayment) {
            const metadata = existingPayment.metadata as
              | { checkoutUrl?: unknown }
              | null;

            const checkoutUrl =
              typeof metadata?.checkoutUrl === "string"
                ? metadata.checkoutUrl
                : null;

            return {
              kind: "existing" as const,
              paymentId: existingPayment.id,
              checkoutUrl,
            };
          }

          const payment = await tx.billingPayment.create({
            data: {
              subscriptionChangeRequestId: changeRequest.id,
              provider: "INTASEND",
              method,
              status: "PENDING",
              amount,
              currency: plan.currency,
              idempotencyKey: `intasend:${changeRequest.id}:${randomUUID()}`,
            },
            select: {
              id: true,
            },
          });

          return {
            kind: "created" as const,
            paymentId: payment.id,
            amount: amount.toString(),
            currency: plan.currency,
            email: user.email.trim(),
            name: user.name.trim(),
            phone: user.phone,
          };
        },
        {
          maxWait: 10_000,
          timeout: 15_000,
        },
      );

      paymentId = checkoutPreparation.paymentId;

      if (checkoutPreparation.kind === "existing") {
        if (checkoutPreparation.checkoutUrl) {
          return response.json({
            success: true,
            data: {
              paymentId: checkoutPreparation.paymentId,
              checkoutUrl: checkoutPreparation.checkoutUrl,
              status: "PENDING",
            },
          });
        }

        return response.status(409).json({
          success: false,
          message:
            "A checkout attempt is already being prepared. Check payment history before trying again.",
        });
      }

      const nameParts = checkoutPreparation.name
        .trim()
        .split(/\s+/);

      const firstName = nameParts.shift() || "PharmaTrack";
      const lastName = nameParts.join(" ") || "Customer";

      const redirectUrl = new URL(appUrl.toString());
      redirectUrl.searchParams.set(
        "billing_payment",
        checkoutPreparation.paymentId,
      );

      const checkout = await createIntaSendCheckout({
        amount: checkoutPreparation.amount,
        currency: checkoutPreparation.currency,
        email: checkoutPreparation.email,
        firstName,
        lastName,
        phoneNumber:
          checkoutPreparation.phone?.trim() || undefined,
        apiRef: checkoutPreparation.paymentId,
        redirectUrl: redirectUrl.toString(),
      });

      /*
       * Persist the checkout identifier and hosted URL so retries
       * can reuse the same pending checkout instead of creating
       * duplicate provider sessions.
       */
      await prisma.billingPayment.update({
        where: {
          id: checkoutPreparation.paymentId,
        },
        data: {
          providerCheckoutId: checkout.id,
          metadata: {
            checkoutUrl: checkout.url,
          },
        },
      });

      await auditService.log({
        action: "BILLING_CHECKOUT_CREATED",
        entity: "BillingPayment",
        entityId: checkoutPreparation.paymentId,
        userId,
        ipAddress: request.ip,
        details: JSON.stringify({
          organizationId,
          requestId,
          method,
          provider: "INTASEND",
          currency: checkoutPreparation.currency,
        }),
      });

      return response.json({
        success: true,
        data: {
          paymentId: checkoutPreparation.paymentId,
          checkoutUrl: checkout.url,
          status: "PENDING",
        },
      });
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : "Unable to start the payment checkout.";

      /*
       * Only mark this attempt failed if we know it failed before
       * successful checkout creation. A later verification/webhook
       * handler will handle provider-confirmed payment results.
       */
      if (
        paymentId &&
        !message.toLowerCase().includes("already being prepared")
      ) {
        try {
          await prisma.billingPayment.updateMany({
            where: {
              id: paymentId,
              provider: "INTASEND",
              status: "PENDING",
              providerCheckoutId: null,
            },
            data: {
              status: "FAILED",
              failedAt: new Date(),
              failureCode: "CHECKOUT_CREATION_FAILED",
              failureMessage: message.slice(0, 500),
            },
          });
        } catch (updateError) {
          console.error(
            "Failed to update the IntaSend checkout record:",
            updateError,
          );
        }
      }

      const clientErrorMessages = [
        "The plan-change request was not found.",
        "Only approved plan-change requests can proceed to checkout.",
        "This plan-change request has already been applied.",
        "The requested subscription plan is no longer active.",
        "This plan does not have a payable price for the selected interval.",
        "Add a valid email address to your account before checkout.",
      ];

      const isClientError =
        clientErrorMessages.includes(message);

      if (!isClientError) {
        console.error("IntaSend checkout creation failed:", error);
      }

      return response.status(
        isClientError ? 400 : 502,
      ).json({
        success: false,
        message: isClientError
          ? message
          : "Unable to start checkout. Please check payment history before retrying.",
      });
    }
  },
);

