
import crypto from "node:crypto";
import express from "express";
import { Prisma } from "@prisma/client";

import { prisma } from "../prisma.js";
import {
  authenticate,
  requireSuperAdmin,
} from "../middleware/auth.js";
import auditService from "../services/audit.js";

const router = express.Router();

router.use(authenticate);
router.use(requireSuperAdmin);

const isNonEmptyString = (
  value: unknown,
): value is string =>
  typeof value === "string" &&
  value.trim().length > 0;

const isValidPrice = (value: unknown): value is number => {
  if (typeof value !== "number" || !Number.isFinite(value)) {
    return false;
  }

  return value >= 0 && Math.round(value * 100) === value * 100;
};

const isValidLimit = (value: unknown): value is number | null =>
  value === null ||
  (typeof value === "number" &&
    Number.isSafeInteger(value) &&
    value >= 0);

const isValidFeatures = (
  value: unknown,
): value is Prisma.InputJsonValue =>
  value !== null &&
  (Array.isArray(value) ||
    (typeof value === "object" && value !== null));

const optionalText = (
  value: unknown,
): string | null | undefined => {
  if (value === undefined) return undefined;
  if (value === null || value === "") return null;
  if (typeof value !== "string") return undefined;
  return value.trim() || null;
};

const planSelect = {
  id: true,
  code: true,
  name: true,
  description: true,
  monthlyPrice: true,
  annualPrice: true,
  currency: true,
  maxUsers: true,
  maxProducts: true,
  maxLocations: true,
  maxMonthlyTransactions: true,
  features: true,
  isActive: true,
  sortOrder: true,
  createdAt: true,
  updatedAt: true,
  _count: {
    select: {
      subscriptions: true,
    },
  },
} satisfies Prisma.SubscriptionPlanSelect;

/* GET /api/super-admin/billing/plans */
router.get("/plans", async (_request, response) => {
  try {
    const plans = await prisma.subscriptionPlan.findMany({
      orderBy: [
        { sortOrder: "asc" },
        { createdAt: "asc" },
      ],
      select: planSelect,
    });

    response.json({
      success: true,
      data: plans,
    });
  } catch (error) {
    console.error("Failed to list subscription plans:", error);
    response.status(500).json({
      success: false,
      message: "Failed to fetch subscription plans.",
    });
  }
});

/* POST /api/super-admin/billing/plans */
router.post("/plans", async (request, response) => {
  try {
    const body = request.body as Record<string, unknown>;

    const {
      code,
      name,
      description,
      monthlyPrice,
      annualPrice,
      currency,
      maxUsers,
      maxProducts,
      maxLocations,
      maxMonthlyTransactions,
      features,
      sortOrder,
    } = body;

    if (!isNonEmptyString(code) || !/^[A-Za-z0-9_-]{2,40}$/.test(code.trim())) {
      response.status(400).json({
        success: false,
        message: "Plan code must be 2–40 letters, numbers, underscores or hyphens.",
      });
      return;
    }

    if (!isNonEmptyString(name) || name.trim().length > 100) {
      response.status(400).json({
        success: false,
        message: "Plan name is required and must not exceed 100 characters.",
      });
      return;
    }

    if (
      !isValidPrice(monthlyPrice) ||
      !isValidPrice(annualPrice)
    ) {
      response.status(400).json({
        success: false,
        message: "Monthly and annual prices must be non-negative amounts with at most two decimal places.",
      });
      return;
    }

    const normalizedCurrency =
      currency === undefined ? "KES" : currency;

    if (
      typeof normalizedCurrency !== "string" ||
      !/^[A-Za-z]{3}$/.test(normalizedCurrency)
    ) {
      response.status(400).json({
        success: false,
        message: "Currency must be a three-letter currency code.",
      });
      return;
    }

    const limits = {
      maxUsers,
      maxProducts,
      maxLocations,
      maxMonthlyTransactions,
    };

    for (const [field, value] of Object.entries(limits)) {
      if (value !== undefined && !isValidLimit(value)) {
        response.status(400).json({
          success: false,
          message: `${field} must be a non-negative integer or null.`,
        });
        return;
      }
    }

    if (
      description !== undefined &&
      description !== null &&
      typeof description !== "string"
    ) {
      response.status(400).json({
        success: false,
        message: "Description must be text or null.",
      });
      return;
    }

    if (
      features !== undefined &&
      features !== null &&
      !isValidFeatures(features)
    ) {
      response.status(400).json({
        success: false,
        message: "Features must be a JSON object or array, or null.",
      });
      return;
    }

    const normalizedSortOrder =
      sortOrder === undefined ? 0 : sortOrder;

    if (
      typeof normalizedSortOrder !== "number" ||
      !Number.isSafeInteger(normalizedSortOrder) ||
      normalizedSortOrder < 0
    ) {
      response.status(400).json({
        success: false,
        message: "Sort order must be a non-negative integer.",
      });
      return;
    }

    const normalizedCode = code.trim().toUpperCase();

    const existing = await prisma.subscriptionPlan.findUnique({
      where: { code: normalizedCode },
      select: { id: true },
    });

    if (existing) {
      response.status(409).json({
        success: false,
        message: "A plan with this code already exists.",
      });
      return;
    }

    const plan = await prisma.subscriptionPlan.create({
      data: {
        id: crypto.randomUUID(),
        code: normalizedCode,
        name: name.trim(),
        description:
          typeof description === "string"
            ? description.trim() || null
            : null,
        monthlyPrice,
        annualPrice,
        currency: normalizedCurrency.toUpperCase(),
        maxUsers: maxUsers === undefined ? null : maxUsers as number | null,
        maxProducts: maxProducts === undefined ? null : maxProducts as number | null,
        maxLocations: maxLocations === undefined ? null : maxLocations as number | null,
        maxMonthlyTransactions:
          maxMonthlyTransactions === undefined
            ? null
            : maxMonthlyTransactions as number | null,
        features:
          features === undefined || features === null
            ? Prisma.JsonNull
            : features as Prisma.InputJsonValue,
        sortOrder: normalizedSortOrder,
      },
      select: planSelect,
    });

    await auditService.log({
      action: "SUBSCRIPTION_PLAN_CREATED",
      entity: "SubscriptionPlan",
      entityId: plan.id,
      details: JSON.stringify({
        code: plan.code,
        name: plan.name,
        monthlyPrice: String(plan.monthlyPrice),
        annualPrice: String(plan.annualPrice),
        currency: plan.currency,
      }),
      userId: request.auth?.sub,
      ipAddress: request.ip,
    });

    response.status(201).json({
      success: true,
      message: "Subscription plan created successfully.",
      data: plan,
    });
  } catch (error) {
    console.error("Failed to create subscription plan:", error);

    response.status(500).json({
      success: false,
      message: "Failed to create subscription plan.",
    });
  }
});

/* PUT /api/super-admin/billing/plans/:id */
router.put("/plans/:id", async (request, response) => {
  try {
    const id = request.params.id;
    const body = request.body as Record<string, unknown>;

    const existing = await prisma.subscriptionPlan.findUnique({
      where: { id },
    });

    if (!existing) {
      response.status(404).json({
        success: false,
        message: "Subscription plan not found.",
      });
      return;
    }

    const {
      code,
      name,
      description,
      monthlyPrice,
      annualPrice,
      currency,
      maxUsers,
      maxProducts,
      maxLocations,
      maxMonthlyTransactions,
      features,
      sortOrder,
    } = body;

    if (
      code !== undefined &&
      (!isNonEmptyString(code) ||
        !/^[A-Za-z0-9_-]{2,40}$/.test(code.trim()))
    ) {
      response.status(400).json({
        success: false,
        message: "Plan code must be 2–40 letters, numbers, underscores or hyphens.",
      });
      return;
    }

    if (
      name !== undefined &&
      (!isNonEmptyString(name) || name.trim().length > 100)
    ) {
      response.status(400).json({
        success: false,
        message: "Plan name is required and must not exceed 100 characters.",
      });
      return;
    }

    if (
      monthlyPrice !== undefined &&
      !isValidPrice(monthlyPrice)
    ) {
      response.status(400).json({
        success: false,
        message: "Monthly price must be a non-negative amount with at most two decimal places.",
      });
      return;
    }

    if (
      annualPrice !== undefined &&
      !isValidPrice(annualPrice)
    ) {
      response.status(400).json({
        success: false,
        message: "Annual price must be a non-negative amount with at most two decimal places.",
      });
      return;
    }

    if (
      currency !== undefined &&
      (typeof currency !== "string" ||
        !/^[A-Za-z]{3}$/.test(currency))
    ) {
      response.status(400).json({
        success: false,
        message: "Currency must be a three-letter currency code.",
      });
      return;
    }

    const limits = {
      maxUsers,
      maxProducts,
      maxLocations,
      maxMonthlyTransactions,
    };

    for (const [field, value] of Object.entries(limits)) {
      if (value !== undefined && !isValidLimit(value)) {
        response.status(400).json({
          success: false,
          message: `${field} must be a non-negative integer or null.`,
        });
        return;
      }
    }

    if (
      description !== undefined &&
      description !== null &&
      typeof description !== "string"
    ) {
      response.status(400).json({
        success: false,
        message: "Description must be text or null.",
      });
      return;
    }

    if (
      features !== undefined &&
      features !== null &&
      !isValidFeatures(features)
    ) {
      response.status(400).json({
        success: false,
        message: "Features must be a JSON object or array, or null.",
      });
      return;
    }

    if (
      sortOrder !== undefined &&
      (typeof sortOrder !== "number" ||
        !Number.isSafeInteger(sortOrder) ||
        sortOrder < 0)
    ) {
      response.status(400).json({
        success: false,
        message: "Sort order must be a non-negative integer.",
      });
      return;
    }

    const normalizedCode =
      typeof code === "string"
        ? code.trim().toUpperCase()
        : undefined;

    if (normalizedCode) {
      const duplicate = await prisma.subscriptionPlan.findFirst({
        where: {
          code: normalizedCode,
          NOT: { id },
        },
        select: { id: true },
      });

      if (duplicate) {
        response.status(409).json({
          success: false,
          message: "Another plan already uses this code.",
        });
        return;
      }
    }

    const updated = await prisma.subscriptionPlan.update({
      where: { id },
      data: {
        ...(normalizedCode !== undefined && { code: normalizedCode }),
        ...(name !== undefined && { name: (name as string).trim() }),
        ...(description !== undefined && {
          description:
            typeof description === "string"
              ? description.trim() || null
              : null,
        }),
        ...(monthlyPrice !== undefined && { monthlyPrice }),
        ...(annualPrice !== undefined && { annualPrice }),
        ...(currency !== undefined && {
          currency: (currency as string).toUpperCase(),
        }),
        ...(maxUsers !== undefined && { maxUsers: maxUsers as number | null }),
        ...(maxProducts !== undefined && { maxProducts: maxProducts as number | null }),
        ...(maxLocations !== undefined && { maxLocations: maxLocations as number | null }),
        ...(maxMonthlyTransactions !== undefined && {
          maxMonthlyTransactions: maxMonthlyTransactions as number | null,
        }),
        ...(features !== undefined && {
          features:
            features === null
              ? Prisma.JsonNull
              : features as Prisma.InputJsonValue,
        }),
        ...(sortOrder !== undefined && { sortOrder }),
      },
      select: planSelect,
    });

    await auditService.log({
      action: "SUBSCRIPTION_PLAN_UPDATED",
      entity: "SubscriptionPlan",
      entityId: updated.id,
      details: JSON.stringify({
        before: {
          code: existing.code,
          name: existing.name,
          monthlyPrice: String(existing.monthlyPrice),
          annualPrice: String(existing.annualPrice),
          currency: existing.currency,
          isActive: existing.isActive,
        },
        after: {
          code: updated.code,
          name: updated.name,
          monthlyPrice: String(updated.monthlyPrice),
          annualPrice: String(updated.annualPrice),
          currency: updated.currency,
          isActive: updated.isActive,
        },
      }),
      userId: request.auth?.sub,
      ipAddress: request.ip,
    });

    response.json({
      success: true,
      message: "Subscription plan updated successfully.",
      data: updated,
    });
  } catch (error) {
    console.error("Failed to update subscription plan:", error);

    response.status(500).json({
      success: false,
      message: "Failed to update subscription plan.",
    });
  }
});

/* PATCH /api/super-admin/billing/plans/:id/status */
router.patch("/plans/:id/status", async (request, response) => {
  try {
    const { isActive } = request.body as {
      isActive?: unknown;
    };

    if (typeof isActive !== "boolean") {
      response.status(400).json({
        success: false,
        message: "isActive must be true or false.",
      });
      return;
    }

    const existing = await prisma.subscriptionPlan.findUnique({
      where: { id: request.params.id },
    });

    if (!existing) {
      response.status(404).json({
        success: false,
        message: "Subscription plan not found.",
      });
      return;
    }

    const plan = await prisma.subscriptionPlan.update({
      where: { id: existing.id },
      data: { isActive },
      select: planSelect,
    });

    await auditService.log({
      action: isActive
        ? "SUBSCRIPTION_PLAN_ACTIVATED"
        : "SUBSCRIPTION_PLAN_DEACTIVATED",
      entity: "SubscriptionPlan",
      entityId: plan.id,
      details: JSON.stringify({
        code: plan.code,
        name: plan.name,
        previousIsActive: existing.isActive,
        isActive: plan.isActive,
      }),
      userId: request.auth?.sub,
      ipAddress: request.ip,
    });

    response.json({
      success: true,
      message: isActive
        ? "Subscription plan activated."
        : "Subscription plan deactivated.",
      data: plan,
    });
  } catch (error) {
    console.error("Failed to change subscription plan status:", error);

    response.status(500).json({
      success: false,
      message: "Failed to change subscription plan status.",
    });
  }
});

export default router;
