/*
 * POST /api/super-admin/billing/organizations/:organizationId/subscription
 *
 * Creates a new subscription record.
 * The amount and currency always come from the server-side plan.
 */
router.post(
  "/organizations/:organizationId/subscription",
  async (request, response) => {
    try {
      const { organizationId } = request.params;

      const body = request.body as {
        planId?: unknown;
        billingInterval?: unknown;
        status?: unknown;
        trialDays?: unknown;
      };

      const {
        planId,
        billingInterval,
        status = "PENDING",
        trialDays,
      } = body;

      if (
        typeof planId !== "string" ||
        !planId.trim()
      ) {
        response.status(400).json({
          success: false,
          message: "A valid subscription plan is required.",
        });
        return;
      }

      if (
        billingInterval !== "MONTHLY" &&
        billingInterval !== "ANNUAL"
      ) {
        response.status(400).json({
          success: false,
          message: "Billing interval must be MONTHLY or ANNUAL.",
        });
        return;
      }

      if (
        status !== "PENDING" &&
        status !== "ACTIVE" &&
        status !== "TRIALING"
      ) {
        response.status(400).json({
          success: false,
          message: "Initial status must be PENDING, ACTIVE, or TRIALING.",
        });
        return;
      }

      if (
        status === "TRIALING" &&
        (
          !Number.isInteger(trialDays) ||
          (trialDays as number) < 1 ||
          (trialDays as number) > 90
        )
      ) {
        response.status(400).json({
          success: false,
          message: "Trial duration must be between 1 and 90 days.",
        });
        return;
      }

      if (
        status !== "TRIALING" &&
        trialDays !== undefined
      ) {
        response.status(400).json({
          success: false,
          message: "Trial duration is only valid for a TRIALING subscription.",
        });
        return;
      }

      const [organization, plan] = await Promise.all([
        prisma.organization.findUnique({
          where: { id: organizationId },
          select: {
            id: true,
            name: true,
          },
        }),
        prisma.subscriptionPlan.findUnique({
          where: { id: planId },
        }),
      ]);

      if (!organization) {
        response.status(404).json({
          success: false,
          message: "Organization not found.",
        });
        return;
      }

      if (!plan || !plan.isActive) {
        response.status(400).json({
          success: false,
          message: "The selected plan does not exist or is inactive.",
        });
        return;
      }

      const now = new Date();

      const amount =
        billingInterval === "MONTHLY"
          ? plan.monthlyPrice
          : plan.annualPrice;

      const trialEndsAt =
        status === "TRIALING"
          ? new Date(
              now.getTime() +
              (trialDays as number) * 24 * 60 * 60 * 1000,
            )
          : null;

      const subscription =
        await prisma.$transaction(async (tx) => {
          // Close any current subscription before assigning another.
          // Historical records are retained.
          await tx.organizationSubscription.updateMany({
            where: {
              organizationId,
              status: {
                in: [
                  "PENDING",
                  "TRIALING",
                  "ACTIVE",
                  "PAST_DUE",
                ],
              },
            },
            data: {
              status: "CANCELED",
              canceledAt: now,
              endedAt: now,
              cancelAtPeriodEnd: false,
            },
          });

          return tx.organizationSubscription.create({
            data: {
              organizationId,
              planId: plan.id,
              billingInterval,
              status,
              amount,
              currency: plan.currency,
              startedAt:
                status === "ACTIVE" || status === "TRIALING"
                  ? now
                  : null,
              trialStartsAt:
                status === "TRIALING" ? now : null,
              trialEndsAt,
              currentPeriodStart:
                status === "ACTIVE" ? now : null,
              currentPeriodEnd:
                status === "ACTIVE"
                  ? addBillingPeriod(now, billingInterval)
                  : null,
            },
            select: subscriptionSelect,
          });
        });

      await auditService.log({
        action: "ORGANIZATION_SUBSCRIPTION_ASSIGNED",
        entity: "OrganizationSubscription",
        entityId: subscription.id,
        details: JSON.stringify({
          organizationId,
          organizationName: organization.name,
          planId: plan.id,
          planCode: plan.code,
          planName: plan.name,
          billingInterval,
          status,
          amount: String(amount),
          currency: plan.currency,
          trialDays: status === "TRIALING" ? trialDays : null,
        }),
        userId: request.auth?.sub,
        ipAddress: request.ip,
      });

      response.status(201).json({
        success: true,
        message: "Organization subscription assigned successfully.",
        data: subscription,
      });
    } catch (error) {
      console.error(
        "Failed to assign organization subscription:",
        error,
      );

      response.status(500).json({
        success: false,
        message: "Failed to assign organization subscription.",
      });
    }
  },
);

/*
 * PATCH /api/super-admin/billing/subscriptions/:id/status
 *
 * Administrative status change only; no payment is created.
 */
router.patch(
  "/subscriptions/:id/status",
  async (request, response) => {
    try {
      const { id } = request.params;
      const body = request.body as {
        status?: unknown;
      };

      const allowedStatuses = [
        "PENDING",
        "TRIALING",
        "ACTIVE",
        "PAST_DUE",
        "CANCELED",
        "EXPIRED",
      ] as const;

      if (
        typeof body.status !== "string" ||
        !allowedStatuses.includes(
          body.status as (typeof allowedStatuses)[number],
        )
      ) {
        response.status(400).json({
          success: false,
          message: "Invalid subscription status.",
        });
        return;
      }

      const existing =
        await prisma.organizationSubscription.findUnique({
          where: { id },
          select: {
            id: true,
            organizationId: true,
            status: true,
            billingInterval: true,
            startedAt: true,
            trialStartsAt: true,
            trialEndsAt: true,
            currentPeriodStart: true,
            currentPeriodEnd: true,
            cancelAtPeriodEnd: true,
            canceledAt: true,
            endedAt: true,
          },
        });

      if (!existing) {
        response.status(404).json({
          success: false,
          message: "Subscription not found.",
        });
        return;
      }

      const nextStatus =
        body.status as (typeof allowedStatuses)[number];

      const now = new Date();

      const data: {
        status: (typeof allowedStatuses)[number];
        startedAt?: Date | null;
        trialStartsAt?: Date | null;
        trialEndsAt?: Date | null;
        currentPeriodStart?: Date | null;
        currentPeriodEnd?: Date | null;
        canceledAt?: Date | null;
        endedAt?: Date | null;
        cancelAtPeriodEnd?: boolean;
      } = {
        status: nextStatus,
      };

      if (nextStatus === "ACTIVE") {
        data.startedAt = existing.startedAt ?? now;
        data.currentPeriodStart =
          existing.currentPeriodStart ?? now;
        data.currentPeriodEnd =
          existing.currentPeriodEnd ??
          addBillingPeriod(now, existing.billingInterval);
        data.canceledAt = null;
        data.endedAt = null;
        data.cancelAtPeriodEnd = false;
      } else if (nextStatus === "TRIALING") {
        const trialStart = existing.trialStartsAt ?? now;

        data.startedAt = existing.startedAt ?? now;
        data.trialStartsAt = trialStart;
        data.trialEndsAt =
          existing.trialEndsAt ??
          new Date(
            trialStart.getTime() + 14 * 24 * 60 * 60 * 1000,
          );
        data.currentPeriodStart = null;
        data.currentPeriodEnd = null;
        data.canceledAt = null;
        data.endedAt = null;
        data.cancelAtPeriodEnd = false;
      } else if (nextStatus === "CANCELED") {
        data.canceledAt = now;
        data.endedAt = now;
        data.cancelAtPeriodEnd = false;
      } else if (nextStatus === "EXPIRED") {
        data.endedAt = now;
        data.cancelAtPeriodEnd = false;
      } else if (nextStatus === "PENDING") {
        data.cancelAtPeriodEnd = false;
      }

      const subscription =
        await prisma.organizationSubscription.update({
          where: { id },
          data,
          select: subscriptionSelect,
        });

      await auditService.log({
        action: "ORGANIZATION_SUBSCRIPTION_STATUS_CHANGED",
        entity: "OrganizationSubscription",
        entityId: id,
        details: JSON.stringify({
          organizationId: existing.organizationId,
          previousStatus: existing.status,
          newStatus: nextStatus,
        }),
        userId: request.auth?.sub,
        ipAddress: request.ip,
      });

      response.json({
        success: true,
        message: "Subscription status updated successfully.",
        data: subscription,
      });
    } catch (error) {
      console.error(
        "Failed to change subscription status:",
        error,
      );

      response.status(500).json({
        success: false,
        message: "Failed to change subscription status.",
      });
    }
  },
);

/* ============================================================
   SUBSCRIPTION PLAN-CHANGE REQUESTS
   ============================================================ */

/*
 * GET /api/super-admin/billing/plan-change-requests
 *
 * Platform-wide request list for Super Admin review.
 */

router.get("/plan-change-requests", async (request, response) => {
  try {
    const statusFilter = request.query.status;

    const allowedStatuses = [
      "PENDING",
      "APPROVED",
      "REJECTED",
      "APPLIED",
    ] as const;

    if (
      typeof statusFilter === "string" &&
      !allowedStatuses.includes(
        statusFilter as (typeof allowedStatuses)[number],
      )
    ) {
      response.status(400).json({
        success: false,
        message: "Invalid plan-change request status filter.",
      });
      return;
    }

    const parsedLimit = Number(request.query.limit ?? 100);
    const limit =
      Number.isInteger(parsedLimit) && parsedLimit >= 1
        ? Math.min(parsedLimit, 200)
        : 100;

    const requests =
      await prisma.subscriptionChangeRequest.findMany({
        where:
          typeof statusFilter === "string"
            ? { status: statusFilter as (typeof allowedStatuses)[number] }
            : undefined,
        orderBy: [
          { createdAt: "desc" },
          { id: "desc" },
        ],
        take: limit,
        select: {
          id: true,
          organizationId: true,
          requestedById: true,
          requestedPlanId: true,
          requestedInterval: true,
          status: true,
          requestReason: true,
          reviewedById: true,
          reviewedAt: true,
          decisionReason: true,
          appliedAt: true,
          createdAt: true,
          updatedAt: true,
          organization: {
            select: {
              id: true,
              name: true,
              type: true,
              status: true,
              email: true,
            },
          },
          requestedBy: {
            select: {
              id: true,
              name: true,
              email: true,
            },
          },
          reviewedBy: {
            select: {
              id: true,
              name: true,
              email: true,
            },
          },
          requestedPlan: {
            select: {
              id: true,
              code: true,
              name: true,
              description: true,
              monthlyPrice: true,
              annualPrice: true,
              currency: true,
              isActive: true,
            },
          },
        },
      });

    response.json({
      success: true,
      data: requests,
    });
  } catch (error) {
    console.error(
      "Failed to fetch subscription plan-change requests:",
      error,
    );

    response.status(500).json({
      success: false,
      message: "Failed to fetch plan-change requests.",
    });
  }
});

/*
 * PATCH /api/super-admin/billing/plan-change-requests/:id/review
 *
 * Body:
 * {
 *   "decision": "APPROVE" | "REJECT",
 *   "reason": "Optional explanation, required for rejection"
 * }
 *
 * Approval does not activate or replace a subscription.
 * A later, separate payment-confirmation or explicitly
 * permitted free/trial flow must apply the change.
 */

router.patch(
  "/plan-change-requests/:id/review",
  async (request, response) => {
    try {
      const requestId =
        typeof request.params.id === "string"
          ? request.params.id.trim()
          : "";

      const reviewerId = request.auth?.sub;

      const body = request.body as {
        decision?: unknown;
        reason?: unknown;
      };

      const decision = body.decision;

      const reason =
        typeof body.reason === "string"
          ? body.reason.trim()
          : "";

      if (!requestId) {
        response.status(400).json({
          success: false,
          message: "A plan-change request ID is required.",
        });
        return;
      }

      if (!reviewerId) {
        response.status(401).json({
          success: false,
          message: "Authenticated Super Admin context is required.",
        });
        return;
      }

      if (decision !== "APPROVE" && decision !== "REJECT") {
        response.status(400).json({
          success: false,
          message: "Decision must be APPROVE or REJECT.",
        });
        return;
      }

      if (reason.length > 1000) {
        response.status(400).json({
          success: false,
          message: "The review reason cannot exceed 1000 characters.",
        });
        return;
      }

      if (decision === "REJECT" && !reason) {
        response.status(400).json({
          success: false,
          message: "A reason is required when rejecting a request.",
        });
        return;
      }

      const updatedRequest = await prisma.$transaction(
        async (tx) => {
          /*
           * Find the request to determine which organization
           * must be locked. Re-read it after obtaining the lock
           * to avoid acting on stale status.
           */
          const initialRequest =
            await tx.subscriptionChangeRequest.findUnique({
              where: { id: requestId },
              select: {
                id: true,
                organizationId: true,
              },
            });

          if (!initialRequest) {
            throw new Error("PLAN_CHANGE_REQUEST_NOT_FOUND");
          }

          await tx.$queryRaw<Array<{ id: string }>>`
            SELECT "id"
            FROM "Organization"
            WHERE "id" = ${initialRequest.organizationId}
            FOR UPDATE
          `;

          const currentRequest =
            await tx.subscriptionChangeRequest.findUnique({
              where: { id: requestId },
              select: {
                id: true,
                organizationId: true,
                status: true,
              },
            });

          if (!currentRequest) {
            throw new Error("PLAN_CHANGE_REQUEST_NOT_FOUND");
          }

          if (currentRequest.status !== "PENDING") {
            throw new Error("PLAN_CHANGE_REQUEST_ALREADY_REVIEWED");
          }

          const nextStatus =
            decision === "APPROVE" ? "APPROVED" : "REJECTED";

          /*
           * Conditional update is a second concurrency guard.
           * The request must still be PENDING when this update
           * executes.
           */
          const updateResult =
            await tx.subscriptionChangeRequest.updateMany({
              where: {
                id: requestId,
                organizationId: currentRequest.organizationId,
                status: "PENDING",
              },
              data: {
                status: nextStatus,
                reviewedById: reviewerId,
                reviewedAt: new Date(),
                decisionReason: reason || null,
              },
            });

          if (updateResult.count !== 1) {
            throw new Error("PLAN_CHANGE_REQUEST_ALREADY_REVIEWED");
          }

          return tx.subscriptionChangeRequest.findUniqueOrThrow({
            where: { id: requestId },
            select: {
              id: true,
              organizationId: true,
              requestedById: true,
              requestedPlanId: true,
              requestedInterval: true,
              status: true,
              requestReason: true,
              reviewedById: true,
              reviewedAt: true,
              decisionReason: true,
              appliedAt: true,
              createdAt: true,
              updatedAt: true,
              organization: {
                select: {
                  id: true,
                  name: true,
                  type: true,
                  status: true,
                  email: true,
                },
              },
              requestedBy: {
                select: {
                  id: true,
                  name: true,
                  email: true,
                },
              },
              reviewedBy: {
                select: {
                  id: true,
                  name: true,
                  email: true,
                },
              },
              requestedPlan: {
                select: {
                  id: true,
                  code: true,
                  name: true,
                  monthlyPrice: true,
                  annualPrice: true,
                  currency: true,
                  isActive: true,
                },
              },
            },
          });
        },
        {
          maxWait: 5000,
          timeout: 10000,
        },
      );

      await auditService.log({
        action:
          decision === "APPROVE"
            ? "SUBSCRIPTION_CHANGE_REQUEST_APPROVED"
            : "SUBSCRIPTION_CHANGE_REQUEST_REJECTED",
        entity: "SubscriptionChangeRequest",
        entityId: updatedRequest.id,
        details: JSON.stringify({
          organizationId: updatedRequest.organizationId,
          requestedPlanId: updatedRequest.requestedPlanId,
          requestedInterval: updatedRequest.requestedInterval,
          decision,
          reason: reason || null,
          resultingStatus: updatedRequest.status,
        }),
        userId: reviewerId,
        ipAddress: request.ip,
        organizationId: updatedRequest.organizationId,
      });

      response.json({
        success: true,
        message:
          decision === "APPROVE"
            ? "The plan-change request has been approved. The current subscription has not been changed."
            : "The plan-change request has been rejected.",
        data: updatedRequest,
      });
    } catch (error) {
      if (error instanceof Error) {
        if (error.message === "PLAN_CHANGE_REQUEST_NOT_FOUND") {
          response.status(404).json({
            success: false,
            message: "Plan-change request not found.",
          });
          return;
        }

        if (
          error.message === "PLAN_CHANGE_REQUEST_ALREADY_REVIEWED"
        ) {
          response.status(409).json({
            success: false,
            message:
              "This request has already been reviewed and can no longer be reviewed again.",
          });
          return;
        }
      }

      console.error(
        "Failed to review subscription plan-change request:",
        error,
      );

      response.status(500).json({
        success: false,
        message: "Failed to review the plan-change request.",
      });
    }
  },
);
export default router;
